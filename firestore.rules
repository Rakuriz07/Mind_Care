rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ==========================================
    // HELPER FUNCTIONS (Fungsi Bantuan Keamanan)
    // ==========================================
    
    // Memeriksa apakah pengguna telah login / terotentikasi melalui Firebase Auth
    function isAuthenticated() {
      return request.auth != null;
    }

    // Memeriksa apakah ID Pengguna terautentikasi sesuai dengan dokumen
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // ==========================================
    // FIRESTORE SECURITY RULES (MindCare App)
    // ==========================================

    // 1. Koleksi Profil Pengguna (users)
    // Hanya pemilik akun yang dapat membaca dan memperbarui data profilnya sendiri
    match /users/{userId} {
      allow read, create, update, delete: if isOwner(userId);
    }

    // 2. Koleksi Skrining Kesehatan Mental (screenings)
    // Pengguna terautentikasi dapat mengelola riwayat skrining berdasarkan userId / email
    match /screenings/{screeningId} {
      allow read, update, delete: if isAuthenticated() && (
        !('userId' in resource.data) ||
        resource.data.userId == request.auth.uid ||
        resource.data.user_email == request.auth.token.email ||
        resource.data.user_email == request.auth.email
      );
      allow create: if isAuthenticated() && (
        !('userId' in request.resource.data) ||
        request.resource.data.userId == request.auth.uid ||
        request.resource.data.user_email == request.auth.token.email ||
        request.resource.data.user_email == request.auth.email
      );
    }

    // 3. Koleksi Jurnal Emosi Harian (journals)
    // Privasi tingkat tinggi: Jurnal pribadi hanya dapat diakses oleh pemiliknya sendiri
    match /journals/{journalId} {
      allow read, update, delete: if isAuthenticated() && (
        !('userId' in resource.data) ||
        resource.data.userId == request.auth.uid ||
        resource.data.user_email == request.auth.token.email ||
        resource.data.user_email == request.auth.email
      );
      allow create: if isAuthenticated() && (
        !('userId' in request.resource.data) ||
        request.resource.data.userId == request.auth.uid ||
        request.resource.data.user_email == request.auth.token.email ||
        request.resource.data.user_email == request.auth.email
      );
    }

    // 4. Koleksi Komunitas (community_posts)
    // Postingan dapat dibaca oleh seluruh pengguna login, pembuat dapat mengunggah & menghapus
    match /community_posts/{postId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && (
        !('authorId' in request.resource.data) ||
        request.resource.data.authorId == request.auth.uid ||
        request.resource.data.authorEmail == request.auth.email ||
        request.resource.data.authorEmail == request.auth.token.email
      );
      allow update: if isAuthenticated(); // Mengizinkan fitur Suka (Likes) & Komentar dari pengguna lain
      allow delete: if isAuthenticated() && (
        !('authorId' in resource.data) ||
        resource.data.authorId == request.auth.uid ||
        resource.data.authorEmail == request.auth.email ||
        resource.data.authorEmail == request.auth.token.email
      );
    }

    // 5. Koleksi Notifikasi (notifications)
    // Pengguna terautentikasi dapat membaca & mengelola notifikasi miliknya sendiri
    match /notifications/{notificationId} {
      allow read, update, delete: if isAuthenticated() && (
        !('userId' in resource.data) ||
        resource.data.userId == request.auth.uid ||
        resource.data.recipientEmail == request.auth.email ||
        resource.data.recipientEmail == request.auth.token.email
      );
      allow create: if isAuthenticated();
    }
  }
}
